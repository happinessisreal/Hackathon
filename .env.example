# Copy to .env and adjust as needed. Never commit the real .env.
DATABASE_URL=sqlite+aiosqlite:///./data/scsrg.db
ENV=development

# Bonus 4 (NL incident reporting) - provider-agnostic LLM call.
# Leave blank to fall back to the offline regex/keyword parser (Bonus 4 still works without a key).
LLM_API_KEY=
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
